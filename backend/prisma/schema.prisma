generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MENTOR
  HOD
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  IDEA
  APPROVED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                    Int                      @id @default(autoincrement())
  email                 String                   @unique
  passwordHash          String                   @map("password_hash")
  role                  UserRole                 @default(STUDENT)
  fullName              String                   @map("full_name")
  profileImage          String?                  @map("profile_image")
  isActive              Boolean                  @default(true) @map("is_active")
  emailVerifiedAt       DateTime?                @map("email_verified_at")
  lockedUntil           DateTime?                @map("locked_until")
  failedLoginCount      Int                      @default(0) @map("failed_login_count")
  lastLogin             DateTime?                @map("last_login")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  studentProfile        StudentProfile?
  mentorProfile         MentorProfile?
  sessions              UserSession[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  loginAttempts         LoginAttempt[]
  auditLogs             AuditLog[]               @relation("AuditActor")
  projectMemberships    ProjectMember[]
  assignedTasks         Task[]                   @relation("TaskAssignee")
  createdProjects       Project[]                @relation("ProjectCreator")
  notifications         Notification[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model StudentProfile {
  userId       Int      @id @map("user_id")
  rollNumber   String   @unique @map("roll_number")
  branchId     Int?     @map("branch_id")
  semester     Int
  section      String?
  subsection   String?
  academicYear String?  @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId, semester, section])
  @@map("students")
}

model MentorProfile {
  userId         Int      @id @map("user_id")
  department     String?
  designation    String?
  specialization String?
  maxProjects    Int      @default(8) @map("max_projects")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@map("mentors")
}

model UserSession {
  id            String    @id @default(cuid())
  userId        Int       @map("user_id")
  refreshTokenHash String @unique @map("refresh_token_hash")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  isRevoked     Boolean   @default(false) @map("is_revoked")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("email_verification_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    Int?     @map("user_id")
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id          String        @id @default(cuid())
  actorId     Int?          @map("actor_id")
  action      String
  entityType  String        @map("entity_type")
  entityId    String?       @map("entity_id")
  severity    AuditSeverity @default(INFO)
  ipAddress   String?       @map("ip_address")
  userAgent   String?       @map("user_agent")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  actor       User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  abstract    String?
  problemStatement String?  @map("problem_statement")
  status      ProjectStatus @default(IDEA)
  healthScore Float?        @map("health_score")
  createdById Int           @map("created_by_id")
  mentorId    Int?          @map("mentor_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  documents   ProjectDocument[]
  messages    ProjectMessage[]

  @@index([status])
  @@index([createdById])
  @@index([mentorId])
  @@map("enterprise_projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("enterprise_project_members")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  dueAt     DateTime? @map("due_at")
  status    TaskStatus @default(TODO)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("enterprise_milestones")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String     @map("project_id")
  assigneeId  Int?       @map("assignee_id")
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  position    Int         @default(0)
  dueAt       DateTime?   @map("due_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@map("enterprise_tasks")
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  senderId  Int      @map("sender_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("enterprise_project_messages")
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  mimeType  String   @map("mime_type")
  storageKey String  @map("storage_key")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ProjectDocumentVersion[]

  @@index([projectId])
  @@map("enterprise_project_documents")
}

model ProjectDocumentVersion {
  id          String   @id @default(cuid())
  documentId  String   @map("document_id")
  versionNo   Int      @map("version_no")
  storageKey  String   @map("storage_key")
  uploadedById Int     @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  document    ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@map("enterprise_project_document_versions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("enterprise_notifications")
}
