generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT @map("student")
  MENTOR @map("mentor")
  HOD @map("hod")
  ADMIN @map("admin")
  SUPER_ADMIN @map("super_admin")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]

  @@map("departments")
}

model Branch {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  code         String?      @unique
  departmentId Int?         @map("department_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students   StudentProfile[] @relation("StudentBranch")
  projects   Project[] @relation("ProjectBranch")
  registrationForms RegistrationForm[] @relation("RegistrationFormBranch")
  projectForms ProjectForm[] @relation("ProjectFormBranch")
  projectRegistrations ProjectRegistration[]
  projectTeamMembers ProjectTeamMember[]

  @@index([departmentId])
  @@map("branches")
}

model Role {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  isSystem    Boolean         @default(false) @map("is_system")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               Int        @id @default(autoincrement())
  email            String     @unique
  passwordHash     String     @map("password_hash")
  role             UserRole   @default(STUDENT)
  fullName         String     @map("full_name")
  profileImage     String?    @map("profile_image")
  mobileNumber     String?    @map("mobile_number")
  isActive         Boolean    @default(true) @map("is_active")
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  lockedUntil      DateTime?  @map("locked_until")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lastLogin        DateTime?  @map("last_login")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  studentProfile          StudentProfile?
  mentorProfile           MentorProfile?
  sessions                UserSession[]
  loginAttempts           LoginAttempt[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[] @relation("AuditActor")
  studentsMentored        StudentProfile[] @relation("StudentMentor")
  projectsCreated         Project[] @relation("ProjectCreatedBy")
  projectsMentored        Project[] @relation("ProjectMentor")
  teamInvitationsSent     TeamInvitation[] @relation("TeamInvitationInviter")
  projectRegistrationsCreated ProjectRegistration[] @relation("ProjectRegistrationCreator")
  projectRegistrationsMentored ProjectRegistration[] @relation("ProjectRegistrationMentor")
  projectTeamMembersAsUser ProjectTeamMember[] @relation("ProjectTeamMemberUser")
  projectTeamMembersAsStudentUser ProjectTeamMember[] @relation("ProjectTeamMemberStudentUser")
  projectRegistrationMembers ProjectRegistrationMember[]
  mentorAllocationsMentor MentorAllocation[] @relation("MentorAllocationMentor")
  mentorAllocationsCreated MentorAllocation[] @relation("MentorAllocationHod")
  mentorAssignmentsMentor MentorAssignment[] @relation("MentorAssignmentMentor")
  mentorAssignmentsMentorUser MentorAssignment[] @relation("MentorAssignmentMentorUser")
  mentorAssignmentsAssigned MentorAssignment[] @relation("MentorAssignmentAssignedBy")
  mentorReviewsMentor     MentorReview[] @relation("MentorReviewMentor")
  mentorReviewsMentorUser MentorReview[] @relation("MentorReviewMentorUser")
  finalEvaluationsMentor  FinalEvaluation[] @relation("FinalEvaluationMentor")
  finalEvaluationsHod     FinalEvaluation[] @relation("FinalEvaluationHod")
  projectMilestonesCreated ProjectMilestone[] @relation("ProjectMilestoneCreator")
  milestoneSubmissionsSubmitted MilestoneSubmission[] @relation("MilestoneSubmissionSubmitter")
  documentTemplatesMentor DocumentTemplate[] @relation("DocumentTemplateMentor")
  documentTemplatesMentorUser DocumentTemplate[] @relation("DocumentTemplateMentorUser")
  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreator")
  documentVersionsUploaded DocumentVersion[] @relation("DocumentVersionUploader")
  studentContributions    StudentContribution[] @relation("StudentContributionStudent")
  studentScores           StudentScore[] @relation("StudentScoreStudent")
  milestoneScoresStudent  MilestoneScore[] @relation("MilestoneScoreStudent")
  notifications           Notification[]
  meetingLogsMentor       MeetingLog[] @relation("MeetingLogMentor")
  calendarEventsCreated   CalendarEvent[] @relation("CalendarEventCreator")
  activityLogsActor       ActivityLog[] @relation("ActivityLogActor")
  documentsUploaded       Document[] @relation("DocumentUploader")
  tasksCreated            Task[] @relation("TaskCreator")
  projectFormsCreated      ProjectForm[] @relation("ProjectFormCreator")
  submissionDeadlinesCreated SubmissionDeadline[] @relation("SubmissionDeadlineCreator")
  documentAssignmentsCreated DocumentAssignment[] @relation("DocumentAssignmentCreator")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model StudentProfile {
  userId           Int       @id @map("user_id")
  fullName         String?   @map("full_name")
  email            String?   @unique
  rollNumber       String    @unique @map("roll_number")
  branchId         Int?      @map("branch_id")
  branchName       String?   @map("branch_name")
  branch           String?   
  department       String?
  year             Int?
  semester         Int
  section          String?
  subsection       String?
  mentorId         Int?      @map("mentor_id")
  mentorName       String?   @map("mentor_name")
  mentorEmail      String?   @map("mentor_email")
  profileLocked    Boolean   @default(false) @map("profile_locked")
  profileUpdatedAt DateTime? @map("profile_updated_at")
  mobileNumber     String?   @map("mobile_number")
  profilePhoto     String?   @map("profile_photo")
  isActive         Boolean   @default(true) @map("is_active")
  universityEmail  String?   @map("university_email")
  profileImage     String?   @map("profile_image")
  academicYear     String?   @map("academic_year")
  currentScore     Float?    @map("current_score")
  contributionScore Float?   @map("contribution_score")
  timelinessScore  Float?    @map("timeliness_score")
  status           String?   @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchRelation Branch? @relation("StudentBranch", fields: [branchId], references: [id], onDelete: SetNull)
  mentor User?   @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  projectMembers ProjectMember[]
  teamInvitationsReceived TeamInvitation[] @relation("TeamInvitationStudent")
  registrationFormSubmissions RegistrationFormSubmission[] @relation("RegistrationFormSubmissionLeader")
  projectTeamMembers ProjectTeamMember[]
  projectRegistrationMembers ProjectRegistrationMember[]
  projectFormSubmissions ProjectFormSubmission[]
  teamMembers TeamMember[]
  documentSubmissions DocumentSubmission[]
  marks Marks[]

  @@index([branchId, semester, section, subsection])
  @@index([mentorId])
  @@index([rollNumber])
  @@index([email])
  @@map("students")
}

model MentorProfile {
  userId         Int       @id @map("user_id")
  department     String?
  designation    String?
  specialization String?
  maxProjects    Int       @default(8) @map("max_projects")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@map("mentors")
}

model UserSession {
  id               String   @id @default(cuid())
  userId           Int      @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    Int?     @map("user_id")
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("email_verification_tokens")
}

model AuditLog {
  id         String        @id @default(cuid())
  actorId    Int?         @map("actor_id")
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  severity   AuditSeverity @default(INFO)
  ipAddress  String?       @map("ip_address")
  userAgent  String?       @map("user_agent")
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Project {
  id               Int       @id @default(autoincrement())
  registrationId   Int?      @map("registration_id")
  title            String
  type             String?
  teamName         String?   @map("team_name")
  description      String?
  problemStatement String?   @map("problem_statement")
  abstract         String?
  techStack        Json?     @map("tech_stack")
  githubLink       String?   @map("github_link")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  status           String    @default("pending")
  progressPercent  Float?    @map("progress_percent")
  branchId         Int?      @map("branch_id")
  branch           String?
  academicYear     String?   @map("academic_year")
  semester         Int?
  section          String?
  subsection       String?
  createdById      Int?      @map("created_by")
  mentorId         Int?      @map("mentor_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  registration ProjectRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  branchRelation Branch?            @relation("ProjectBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mentor       User?                @relation("ProjectMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([branchId, academicYear, semester, section, subsection])
  @@index([createdById])
  @@index([mentorId])
  @@map("projects")
}

model ProjectMember {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  registrationId Int?   @map("registration_id")
  studentId   Int       @map("student_id")
  role        String    @default("Member")
  isLeader    Boolean   @default(false) @map("is_leader")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registration ProjectRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  student      StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([registrationId])
  @@map("project_members")
}

model TeamInvitation {
  inviteId          Int       @id @default(autoincrement()) @map("invite_id")
  projectId         Int       @map("project_id")
  inviterId         Int       @map("inviter_id")
  invitedStudentId  Int       @map("invited_student_id")
  status            String    @default("Pending")
  createdAt         DateTime  @default(now()) @map("created_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter        User           @relation("TeamInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedStudent StudentProfile @relation("TeamInvitationStudent", fields: [invitedStudentId], references: [userId], onDelete: Cascade)

  @@unique([projectId, invitedStudentId])
  @@index([inviterId, status])
  @@map("team_invitations")
}

model RegistrationForm {
  id             Int       @id @default(autoincrement())
  title          String
  instructions   String?
  branch         String?
  branchId       Int?      @map("branch_id")
  academicYear   String?   @map("academic_year")
  semester       Int?
  section        String?
  subsection     String?
  teamSizeMin    Int       @default(1) @map("team_size_min")
  teamSizeMax    Int       @default(4) @map("team_size_max")
  projectType    String?   @map("project_type")
  startDate      DateTime? @map("start_date")
  deadline       DateTime?
  status         String    @default("draft")
  isPublished    Boolean   @default(false) @map("is_published")
  createdById    Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branchRelation Branch? @relation("RegistrationFormBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("RegistrationFormCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, academicYear, semester, section, subsection])
  @@index([status, isPublished])
  @@map("registration_forms")
}

model RegistrationFormSubmission {
  id              Int      @id @default(autoincrement())
  formId          Int      @map("form_id")
  projectTitle    String   @map("project_title")
  projectDomain   String?  @map("project_domain")
  problemStatement String? @map("problem_statement")
  abstract        String?
  techStack       Json?    @map("tech_stack")
  leaderId        Int?     @map("leader_id")
  teamMembers     Json?    @map("team_members")
  status          String   @default("Pending")
  remarks         String?
  submittedAt     DateTime @default(now()) @map("submitted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  form   RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  leader StudentProfile?  @relation(fields: [leaderId], references: [userId], onDelete: SetNull)

  @@index([formId, status])
  @@index([leaderId])
  @@map("registration_form_submissions")
}

model ProjectRegistration {
  id                 Int      @id @default(autoincrement())
  registrationFormId  Int?     @map("registration_form_id")
  submissionId        Int?     @unique @map("submission_id")
  title              String
  projectDomain      String?  @map("project_domain")
  problemStatement   String?  @map("problem_statement")
  abstract           String?
  techStack          Json?    @map("tech_stack")
  teamName           String?  @map("team_name")
  githubLink         String?  @map("github_link")
  status             String   @default("Pending")
  createdById        Int?     @map("created_by")
  mentorId           Int?     @map("mentor_id")
  branchId           Int?     @map("branch_id")
  academicYear       String?  @map("academic_year")
  semester           Int?
  section            String?
  subsection         String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  registrationForm RegistrationForm?        @relation(fields: [registrationFormId], references: [id], onDelete: SetNull)
  submission       RegistrationFormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdBy        User?                      @relation("ProjectRegistrationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mentor           User?                      @relation("ProjectRegistrationMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  branch           Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([registrationFormId, status])
  @@index([branchId, academicYear, semester, section, subsection])
  @@index([createdById])
  @@index([mentorId])
  @@map("project_registrations")
}

model ProjectTeamMember {
  id                Int       @id @default(autoincrement())
  submissionId      Int?      @map("submission_id")
  projectRegistrationId Int?   @map("project_registration_id")
  formId            Int?      @map("form_id")
  userId            Int?      @map("user_id")
  studentUserId     Int?      @map("student_user_id")
  studentId         Int?      @map("student_id")
  fullName          String?   @map("full_name")
  email             String?
  rollNumber        String?   @map("roll_number")
  branchId          Int?      @map("branch_id")
  branchName        String?   @map("branch_name")
  academicYear      String?   @map("academic_year")
  semester          Int?
  section           String?
  subsection        String?
  role              String    @default("Member")
  isLeader          Boolean   @default(false) @map("is_leader")
  isTeamLeader      Boolean?  @map("is_team_leader")
  joinedAt          DateTime? @map("joined_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  submission        RegistrationFormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  projectRegistration ProjectRegistration? @relation(fields: [projectRegistrationId], references: [id], onDelete: SetNull)
  form              RegistrationForm?           @relation(fields: [formId], references: [id], onDelete: SetNull)
  user              User?                       @relation("ProjectTeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  studentUser       User?                       @relation("ProjectTeamMemberStudentUser", fields: [studentUserId], references: [id], onDelete: SetNull)
  student           StudentProfile?             @relation(fields: [studentId], references: [userId], onDelete: SetNull)
  branch            Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([projectRegistrationId])
  @@index([studentId, role])
  @@map("project_team_members")
}

model ProjectRegistrationMember {
  id            Int       @id @default(autoincrement())
  registrationId Int?     @map("registration_id")
  submissionId  Int?      @map("submission_id")
  formId        Int?      @map("form_id")
  userId        Int?      @map("user_id")
  studentName   String?   @map("student_name")
  studentEmail  String?   @map("student_email")
  rollNumber    String?   @map("roll_number")
  teamRole      String?   @map("team_role")
  isLeader      Boolean   @default(false) @map("is_leader")
  createdAt     DateTime  @default(now()) @map("created_at")

  registration ProjectRegistration?         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submission   RegistrationFormSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  form         RegistrationForm?            @relation(fields: [formId], references: [id], onDelete: SetNull)
  user         User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([submissionId])
  @@map("project_registration_members")
}

model MentorAllocation {
  id             Int       @id @default(autoincrement())
  year           Int?
  academicYear   String?   @map("academic_year")
  semester       Int?
  section        String?
  subsection     String?
  mentorId       Int?      @map("mentor_id")
  mentorName     String?   @map("mentor_name")
  mentorEmail    String?   @map("mentor_email")
  createdByHodId Int?      @map("created_by_hod")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  mentor       User? @relation("MentorAllocationMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  createdByHod User? @relation("MentorAllocationHod", fields: [createdByHodId], references: [id], onDelete: SetNull)

  @@unique([academicYear, semester, section, subsection])
  @@index([mentorId])
  @@map("mentor_allocations")
}

model MentorAssignment {
  id            Int       @id @default(autoincrement())
  mentorId      Int?      @map("mentor_id")
  mentorUserId  Int?      @map("mentor_user_id")
  projectId     Int?      @map("project_id")
  registrationId Int?     @map("registration_id")
  submissionId  Int?      @map("submission_id")
  assignedById  Int?      @map("assigned_by")
  section       String?
  subsection    String?
  academicYear  String?   @map("academic_year")
  branch        String?
  domain        String?
  allocationId  Int?      @map("allocation_id")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  mentor       User? @relation("MentorAssignmentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  mentorUser   User? @relation("MentorAssignmentMentorUser", fields: [mentorUserId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registration ProjectRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  submission   RegistrationFormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  assignedBy   User? @relation("MentorAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  allocation   MentorAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  @@index([mentorId, mentorUserId])
  @@index([projectId])
  @@index([registrationId])
  @@map("mentor_assignments")
}

model MentorReview {
  id                 Int       @id @default(autoincrement())
  submissionId       Int?      @map("submission_id")
  milestoneSubmissionId Int?    @map("milestone_submission_id")
  projectRegistrationId Int?    @map("project_registration_id")
  mentorId           Int?      @map("mentor_id")
  mentorUserId       Int?      @map("mentor_user_id")
  status             String?
  remarks            String?
  comments           String?
  qualityMarks       Float?    @map("quality_marks")
  feedback           String?
  marks              Float?
  reviewStatus       String?   @map("review_status")
  reviewedAt         DateTime? @map("reviewed_at")
  updatedAt          DateTime? @map("updated_at")

  submission        RegistrationFormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  milestoneSubmission MilestoneSubmission?      @relation(fields: [milestoneSubmissionId], references: [id], onDelete: SetNull)
  projectRegistration ProjectRegistration?      @relation(fields: [projectRegistrationId], references: [id], onDelete: SetNull)
  mentor            User?                        @relation("MentorReviewMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  mentorUser        User?                        @relation("MentorReviewMentorUser", fields: [mentorUserId], references: [id], onDelete: SetNull)

  @@index([mentorId, mentorUserId])
  @@index([projectRegistrationId])
  @@index([submissionId])
  @@map("mentor_reviews")
}

model FinalEvaluation {
  id                 Int       @id @default(autoincrement())
  projectRegistrationId Int    @map("project_registration_id")
  mentorId           Int?      @map("mentor_id")
  hodId              Int?      @map("hod_id")
